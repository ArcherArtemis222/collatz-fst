# Lake build 產物與依賴原始碼：絕對不要進 git（會變成好幾 GB）
/.lake/
**/.lake/
*.olean
*.ilean
*.trace
*.hash

# 編輯器 / OS
.DS_Store
.vscode/
.idea/
*.swp

# 本機暫存
/scratch/
/tmp/
*.log

# Python 快取（tools/ 腳本被 import 時產生）
__pycache__/
*.pyc

# LaTeX 編譯產物（paper/；PDF 不進 git，要看就本機 latexmk）
paper/*.aux
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.toc
paper/*.pdf
